{
  "name": "octopus-regression",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Testy regresji Octopus dev przez interfejs przeglądarki",
  "scripts": {
    "login": "node scripts/login.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "login:auto": "node scripts/check-auth.mjs --force",
    "test:auth": "node --test scripts/auth.test.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:workers:2": "cross-env OCTOPUS_WORKERS=2 playwright test",
    "test:workers:4": "cross-env OCTOPUS_WORKERS=4 playwright test",
    "test:annual:dev": "cross-env OCTOPUS_INCLUDE_ANNUAL=1 OCTOPUS_WORKERS=1 playwright test tests/szkola-medalowosc-annual.spec.ts --config=playwright.config.ts",
    "test:annual:test": "cross-env OCTOPUS_INCLUDE_ANNUAL=1 OCTOPUS_WORKERS=1 playwright test tests/szkola-medalowosc-annual.spec.ts --config=playwright.test.config.ts",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "cleanup:preview": "node scripts/cleanup-preview.mjs",
    "cleanup:teachers": "node scripts/cleanup-teachers.mjs",
    "test:cleanup": "node --test scripts/cleanup-teachers.test.mjs",
    "report": "playwright show-report",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:scenarios": "node scripts/generate-scenario-index.mjs",
    "docs:scenarios:check": "node scripts/generate-scenario-index.mjs --check",
    "quality": "npm run check && npm run lint && npm run format:check && npm run docs:scenarios:check",
    "install:browser": "playwright install chromium",
    "test:dev": "cross-env OCTOPUS_ENV=dev playwright test",
    "test:test": "cross-env OCTOPUS_ENV=test playwright test",
    "test:ui:dev": "cross-env OCTOPUS_ENV=dev playwright test --ui",
    "test:ui:test": "cross-env OCTOPUS_ENV=test playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22"
  }
}
