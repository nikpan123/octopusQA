{
  "name": "octopus-regression",
  "version": "1.0.0",
  "private": true,
  "description": "Testy regresji Octopus dev przez interfejs przeglądarki",
  "type": "module",
  "scripts": {
    "login": "node scripts/login.mjs",
    "auth:check": "node scripts/check-auth.mjs",
    "login:auto": "node scripts/check-auth.mjs --force",
    "test:auth": "node --test scripts/auth.test.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "cleanup:preview": "node scripts/cleanup-preview.mjs",
    "cleanup:teachers": "node scripts/cleanup-teachers.mjs",
    "test:cleanup": "node --test scripts/cleanup-teachers.test.mjs",
    "report": "playwright show-report",
    "check": "tsc --noEmit",
    "install:browser": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-playwright": "2.12.0",
    "prettier": "3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "engines": {
    "node": ">=22"
  }
}
