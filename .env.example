# Skopiuj jako .env i wpisz swoje dane pomiędzy cudzysłowami.
# .env jest lokalny i wykluczony z Gita. Nie przesyłaj go innym.
GITLAB_USERNAME=''
GITLAB_PASSWORD=''
OCTOPUS_DEV_USERNAME=''
OCTOPUS_DEV_PASSWORD=''
OCTOPUS_TEST_USERNAME=''
OCTOPUS_TEST_PASSWORD=''
# Opcjonalny pakiet SQL: wyłącznie SELECT, baza DEV. Nie wysyłaj pliku .env.
OCTOPUS_DEV_DB_SERVER=''
OCTOPUS_DEV_DB_PORT='1433'
OCTOPUS_DEV_DB_NAME='GWO_CRMDEV'
OCTOPUS_DEV_DB_USER=''
OCTOPUS_DEV_DB_PASSWORD=''
OCTOPUS_DEV_DB_ENCRYPT='true'
OCTOPUS_DEV_DB_TRUST_SERVER_CERTIFICATE='false'
# Osobne konto tylko do testu odmowy kopiowania ORD-COPY-19 (DEV).
OCTOPUS_DEV_NO_SCHOOL_EDIT_USERNAME=''
OCTOPUS_DEV_NO_SCHOOL_EDIT_PASSWORD=''
# Starsze nazwy pozostają fallbackiem wyłącznie dla DEV.
OCTOPUS_USERNAME=''
OCTOPUS_PASSWORD=''
# Konto DEV bez School.EDIT do ORD-COPY-19.
# Wpisz dane lokalnie; nie zmieniaj danych glownego konta ponizej.
OCTOPUS_DEV_NO_SCHOOL_EDIT_USERNAME=''
OCTOPUS_DEV_NO_SCHOOL_EDIT_PASSWORD=''

# SQL Server DEV — test soft delete (zapytania testu tylko do odczytu).
